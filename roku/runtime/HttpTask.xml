<?xml version="1.0" encoding="utf-8" ?>
<!-- EveryUI's HTTP request on the Roku: an roUrlTransfer in a Task node (roku/runtime/HttpTask.brs). -->
<component name="EveryUIHttpTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="method" type="string" />
    <field id="headers" type="assocarray" />
    <field id="body" type="string" />
    <field id="result" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HttpTask.brs" />
</component>
