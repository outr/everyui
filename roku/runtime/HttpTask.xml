<?xml version="1.0" encoding="utf-8" ?>
<!-- EveryUI's HTTP worker on the Roku: a long-lived roUrlTransfer in a Task node (roku/runtime/HttpTask.brs). -->
<component name="EveryUIHttpTask" extends="Task">
  <interface>
    <field id="ready" type="boolean" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <field id="result" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HttpTask.brs" />
</component>
