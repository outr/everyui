<?xml version="1.0" encoding="utf-8"?>
<!-- the everyui-monaco gallery on Android: `sbt monacoAndroid/packageApk`. No network permission: Monaco is served from the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.outr.everyui.monaco">
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <application android:label="everyui-monaco" android:icon="@mipmap/ic_launcher" android:banner="@drawable/banner"
    android:supportsRtl="true"
    android:enableOnBackInvokedCallback="false"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity
      android:name="everyui.monaco.gallery.GalleryActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
