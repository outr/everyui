<?xml version="1.0" encoding="utf-8"?>
<!-- A tapped part of a widget, within a row, sharing the row's width with the others.
     Its content carries the tap, and nothing else does: a launcher reapplies a later draw to the views it has,
     each keeping a tap it was given until it is given another, and every draw gives this one its own. In a list's
     row a tap set here is heard as the part's own, where one set on a part's first view is the whole row's
     (everyui.render.WidgetViews). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="0dp"
  android:layout_height="wrap_content"
  android:layout_weight="1">
  <FrameLayout
    android:id="@+id/everyui_widget_tap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />
</FrameLayout>
