<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen widget tapped as a whole (everyui.render.WidgetViews): as everyui_widget_base, its content carrying
     the tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/everyui_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/everyui_widget_ground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:src="@drawable/everyui_widget_ground" />
  <LinearLayout
    android:id="@+id/everyui_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp" />
</FrameLayout>
