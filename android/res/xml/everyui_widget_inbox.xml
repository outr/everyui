<?xml version="1.0" encoding="utf-8"?>
<!-- The example app's "inbox" widget (everyui.app.InboxWidgets), drawn by everyui.render.WidgetReceiver: compact at
     two cells square, a list once it is wider and taller. Set as it is placed, and again from a long press (Android 12
     on), in everyui.activity.WidgetConfigureActivity. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="60dp"
  android:minResizeHeight="60dp"
  android:maxResizeWidth="640dp"
  android:maxResizeHeight="640dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:resizeMode="horizontal|vertical"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/everyui_widget_root"
  android:previewImage="@mipmap/ic_launcher"
  android:configure="everyui.activity.WidgetConfigureActivity"
  android:widgetFeatures="reconfigurable|configuration_optional"
  android:widgetCategory="home_screen" />
