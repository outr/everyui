<?xml version="1.0" encoding="utf-8"?>
<!-- everyui on Android phones and Android TV. Packaged by `sbt android/packageApk` (build.sbt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.outr.everyui">
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:label="EveryUI" android:icon="@mipmap/ic_launcher" android:banner="@drawable/banner"
    android:usesCleartextTraffic="true"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity
      android:name="everyui.activity.MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
